{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "仿生机器人公司 AI 员工系统总体健康度 — 工具调用错误率 / 延迟 / 失败堆积 / 员工 QPS / 错误类别。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "agent-system-health",
  "title": "Agent 系统总览 SLO",
  "tags": ["agent", "slo", "wave2", "proposal-4"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "interval",
        "type": "interval",
        "label": "聚合粒度",
        "auto": true,
        "auto_count": 60,
        "auto_min": "1m",
        "query": "1m,5m,15m,1h",
        "current": { "text": "auto", "value": "$__auto_interval_interval" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "工具调用错误率(按 server_name)",
      "description": "过去 24h,每个 MCP server 的调用错误率(status != 'ok' 的占比)。SLO 目标 < 5%。",
      "datasource": { "type": "postgres", "uid": "company_pg" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.15 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "company_pg" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, $interval), server_name AS metric, SUM(CASE WHEN status <> 'ok' THEN 1 ELSE 0 END)::float / NULLIF(COUNT(*),0) AS value FROM tool_call_log WHERE $__timeFilter(created_at) GROUP BY 1, server_name ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "工具调用 P95 延迟(top 10 tool_name)",
      "description": "过去 24h 调用次数 top 10 的工具,按 tool_name 拆分的 P95 延迟(ms)。",
      "datasource": { "type": "postgres", "uid": "company_pg" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "company_pg" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH top_tools AS (\n  SELECT tool_name FROM tool_call_log\n  WHERE $__timeFilter(created_at)\n  GROUP BY tool_name ORDER BY count(*) DESC LIMIT 10\n)\nSELECT $__timeGroupAlias(t.created_at, $interval),\n       t.tool_name AS metric,\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY t.duration_ms) AS value\nFROM tool_call_log t\nJOIN top_tools tt USING (tool_name)\nWHERE $__timeFilter(t.created_at) AND t.duration_ms IS NOT NULL\nGROUP BY 1, t.tool_name\nORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "失败队列堆积",
      "description": "tool_failure_queue 中尚未被 retro 消费的失败条数(retro_consumed_at IS NULL)。SLO < 50。",
      "datasource": { "type": "postgres", "uid": "company_pg" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 18 },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "company_pg" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"未消费失败\" FROM tool_failure_queue WHERE retro_consumed_at IS NULL"
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "每员工调用 QPS(过去 1h)",
      "description": "过去 1 小时各 employee_key 的工具调用速率(次/秒)。",
      "datasource": { "type": "postgres", "uid": "company_pg" },
      "gridPos": { "h": 9, "w": 12, "x": 6, "y": 18 },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": { "values": true, "calcs": ["lastNotNull"], "fields": "" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "company_pg" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT employee_key AS metric, count(*)::float / 3600 AS value FROM tool_call_log WHERE created_at > now() - interval '1 hour' GROUP BY employee_key ORDER BY value DESC"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "错误类别 top 10(过去 24h)",
      "description": "tool_call_log.error_class 分组 top 10,辅助定位最常见的工具失败类型。",
      "datasource": { "type": "postgres", "uid": "company_pg" },
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 18 },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "次数" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 10 },
                    { "color": "red", "value": 50 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "company_pg" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(error_class, '(null)') AS \"error_class\", count(*) AS \"次数\" FROM tool_call_log WHERE $__timeFilter(created_at) AND status <> 'ok' GROUP BY error_class ORDER BY 2 DESC LIMIT 10"
        }
      ]
    }
  ]
}
